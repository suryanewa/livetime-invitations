{
  "name": "livetime-invitations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Livetime invitation interactions: five real-time 3D RSVP scenes with an embeddable controller.",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "models": "node --experimental-transform-types --no-warnings scripts/export-models.ts",
    "capture": "node --experimental-transform-types --no-warnings scripts/capture.ts",
    "test:browser": "playwright test",
    "package:release": "node --experimental-transform-types --no-warnings scripts/package-release.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
